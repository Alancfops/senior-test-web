# STF Gerenciador Web — variáveis de ambiente
# Copie para .env na raiz deste repositório

# Modo protótipo — dados fictícios (true) ou API real STF (false)
VITE_USE_MOCK_API=true

# URL da API Sênior Teste Funcional (sem barra final)
VITE_STF_API_URL=http://localhost:3000

# Atraso simulado das respostas mock (ms)
VITE_MOCK_DELAY_MS=350

# No STF (backend/.env), liberar origem do Vite em dev:
# CORS_ORIGINS=http://localhost:5173

# Produção (exemplo):
# VITE_STF_API_URL=https://api.seudominio.exemplo.com
